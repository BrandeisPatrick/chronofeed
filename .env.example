# Copy to .env.local and fill in. .env.local is git-ignored; never commit a real key.

# Required unless CHRONOFEED_MOCK=1. Server-side only; it never reaches the browser.
ANTHROPIC_API_KEY=

# Model for the director (opening feed). Default: claude-opus-5-5.
# claude-haiku-5-5 is much cheaper and faster.
# CHRONOFEED_MODEL=claude-opus-5-5

# Model for persona replies and background posts. Default: same as CHRONOFEED_MODEL.
# CHRONOFEED_PERSONA_MODEL=claude-haiku-5-5

# Reasoning effort: low | medium | high | xhigh | max. Default: low.
# CHRONOFEED_EFFORT=low

# Server-side refusal fallbacks on supported models. Set to "off" to disable.
# CHRONOFEED_FALLBACKS=on

# Set to 1 to stream deterministic template content with no API calls.
# CHRONOFEED_MOCK=1
